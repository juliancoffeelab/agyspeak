{
  "name": "agyspeak-android",
  "version": "0.1.0",
  "packageManager": "pnpm@12.15.0",
  "main": "index.ts",
  "dependencies": {
    "@legendapp/list": "^3.7.1",
    "@tanstack/react-query": "^5.105.3",
    "eventsource-parser": "^4.1.3",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.67.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@react-native/eslint-plugin": "^0.88.1",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "sh scripts/android.sh run:android --app-id dev.agyspeak.app.dev",
    "android:release": "sh scripts/android.sh run:android --variant release --app-id dev.agyspeak.app",
    "android:usb": "sh scripts/android.sh install-release",
    "build:apk": "sh scripts/android.sh build-apk",
    "build:release": "sh scripts/android.sh build-release",
    "prebuild": "sh scripts/android.sh prebuild --platform android",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "key:qr": "uv run scripts/key-qr.py",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true
}
